# Never commit local secrets (admin/submit tokens, API keys).
.env
.env.*

# Per-server HMAC salt for reporter pseudonyms. Losing it resets every
# reporter to a stranger; leaking it de-anonymises the report store.
server/.reporter-salt

# The popup capture prints the signed-in account id in its capability
# panel. It is written to a temp dir by tools/make-store-assets.js and must
# never be committed.
docs/shots/popup.png

# Firebase litter: the emulators drop their logs in the repo root, and
# deploys keep a per-project cache under .firebase/.
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/

# Generated by tools/publish-static.js from blocklist/current; never authored.
hosting/blocklist.json
