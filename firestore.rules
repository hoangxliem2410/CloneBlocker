rules_version = '2';

// The whole trust model in one file.
//
//   blocklist/current   public read  -- the published list the extension polls
//   reports/*           public CREATE only, shape-validated -- anyone can file
//   decisions/*         admin only   -- approve / reject / reopen
//   admin/*             admin only   -- manual list entries, docIdOverrides
//
// Reporting is deliberately open (the gate belongs at approval, not intake),
// but every field a stranger can set is bounded, and a report can only ever be
// CREATED -- never read back, never edited, never deleted -- by the public.
// The document id doubles as the dedup key: one reporter, one target, one doc,
// so a repeat report is a create conflict rather than a second row.
//
// Rules REJECT oversized input rather than truncating it (rules cannot rewrite
// data); the extension clips to the same limits before sending.

service cloud.firestore {
  match /databases/{database}/documents {

    // The admin allowlist.
    //
    // A list rather than the single pinned uid this used to be: a Google
    // sign-in mints a different uid than the password account, and one person
    // moderating through either has to be the same admin. Membership is all
    // the rules ever ask -- nothing here cares WHICH admin is writing.
    //
    // Shape contract, because the tool that maintains this list
    // ('firebase-setup.js --add-admin <uid>') rewrites the literal with a
    // regex rather than parsing the rules language. The block always looks
    // exactly like the one below: a line ending in `return [`, then one
    // single-quoted uid alone on each line, then a line holding only `];`.
    // That is enough for the tool to capture the body between those two
    // lines, read the uids out of it, append the new one and re-render the
    // whole block -- so nothing depends on where the commas sit, and adding
    // a uid that is already listed is a no-op rather than a duplicate.
    //
    // The production password account stays first. tools/firebase-test.js
    // re-pins it onto a test uid by plain string replacement and finds which
    // string to replace by the pre-list form of this test,
    // request.auth.uid == 'a0XiGqlhbYhT8S8QacNYKBLFiwd2', which is why that
    // spelling survives in prose here while the live test below reads the list.
    function adminUids() {
      return [
        'a0XiGqlhbYhT8S8QacNYKBLFiwd2'
      ];
    }

    // The claim document, and why the allowlist is not only a literal.
    //
    // A uid baked into this file can only be added by editing and deploying
    // it, which means the owner cannot become an admin by signing in with
    // Google -- they would have to learn their own uid first, from a
    // dashboard they cannot open. So the first person to sign in claims the
    // project: admin/allowlist is created once, with exactly its creator in
    // it, and from then on it is admin-only like everything else.
    //
    // Trust on first use, with the window stated honestly rather than hidden:
    // between deploying this and someone claiming it, ANY account that can
    // sign in can take it. That is why firebase-setup keeps sign-up disabled
    // by default, opens it only for the claim, and closes it again the moment
    // the document exists -- and why --claim-status exists to ask whether the
    // window is still open.
    function claimed() {
      return exists(/databases/$(database)/documents/admin/allowlist);
    }
    function claimedUids() {
      return get(/databases/$(database)/documents/admin/allowlist).data.uids;
    }

    function isAdmin() {
      return request.auth != null
          && (request.auth.uid in adminUids()
              || (claimed() && request.auth.uid in claimedUids()));
    }

    // Optional string field: absent, or non-empty and within `max`.
    function optStr(d, f, max) {
      return !(f in d) || (d[f] is string && d[f].size() >= 1 && d[f].size() <= max);
    }

    // The one tag vocabulary. A report's `reason` is a vote cast from it and a
    // decision's `tag` is the verdict, so both are checked against this list --
    // if the two ever drift apart, a target's verdict stops being sayable in
    // the same words its reports used.
    function optTag(d, f) {
      return !(f in d)
          || d[f] in ['clone', 'impersonation', 'scam', 'harassment', 'spam',
                      'redbull', 'other'];
    }

    // Optional boolean field: absent, or an actual bool. Absent and false mean
    // the same thing to every reader, so nothing needs a default here.
    function optBool(d, f) {
      return !(f in d) || d[f] is bool;
    }

    // A URL a stranger typed. http(s) only -- one javascript: href rendered as
    // a link in the dashboard would run with the admin's session.
    function optUrl(d, f) {
      return !(f in d)
          || (d[f] is string && d[f].size() <= 300 && d[f].matches('https?://.*'));
    }

    // Public read by document, which is what the transparency page needs: it
    // reads blocklist/publicView unauthenticated over this same endpoint, and
    // that doc is already covered by the {doc} wildcard below. No rule of its
    // own -- publicView is a blocklist document like 'current', published by
    // the same admin write, and giving it a second rule would be a second
    // place for the two to drift apart. What keeps it safe to read is what
    // buildPublicView() puts in it, not who may fetch it.
    match /blocklist/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if
        // No fields beyond the contract.
        request.resource.data.keys().hasOnly([
          'platform', 'target', 'profileId', 'username', 'displayName', 'url',
          'reason', 'note', 'postUrl', 'postId', 'contentSummary',
          'region', 'lang', 'reporterHash', 'dedupKey'
        ])
        // Required identity of the report.
        && request.resource.data.platform in ['facebook', 'threads']
        && request.resource.data.target is string
        && request.resource.data.target.matches('([0-9]{4,24}|@[a-z0-9._]{1,64})')
        && request.resource.data.reason in
             ['clone', 'impersonation', 'scam', 'harassment', 'spam', 'redbull', 'other']
        // Reporter binding: the pseudonym, and the doc id that makes a repeat
        // report from the same account a structural no-op.
        && request.resource.data.reporterHash is string
        && request.resource.data.reporterHash.matches('acct_[0-9a-f]{24}')
        && request.resource.data.dedupKey ==
             request.resource.data.platform + '~' + request.resource.data.target
               + '~' + request.resource.data.reporterHash
        && reportId == request.resource.data.dedupKey
        // A numeric target IS the profile id; an @target IS the username.
        // Nothing can claim one identity in the key and another in the fields.
        && (
          (request.resource.data.target.matches('[0-9]{4,24}')
            && request.resource.data.profileId == request.resource.data.target
            && optStr(request.resource.data, 'username', 64))
          ||
          (request.resource.data.target.matches('@[a-z0-9._]{1,64}')
            && !('profileId' in request.resource.data)
            && request.resource.data.username is string
            && request.resource.data.target == '@' + request.resource.data.username)
        )
        // Bounded free text (same caps the Node server enforced).
        && optStr(request.resource.data, 'displayName', 80)
        && optStr(request.resource.data, 'note', 400)
        && optStr(request.resource.data, 'contentSummary', 400)
        && optStr(request.resource.data, 'postId', 64)
        && optUrl(request.resource.data, 'url')
        && optUrl(request.resource.data, 'postUrl')
        // Coarse origin, both optional and narrow: these strings become
        // object keys and dashboard labels.
        && (!('region' in request.resource.data)
            || (request.resource.data.region is string
                && request.resource.data.region.size() <= 64
                && request.resource.data.region.matches('[A-Za-z]{2,}(/[A-Za-z0-9_+-]{1,40}){0,2}')))
        && (!('lang' in request.resource.data)
            || (request.resource.data.lang is string
                && request.resource.data.lang.size() <= 16
                && request.resource.data.lang.matches('[a-z]{2,3}(-[a-z0-9]{2,8}){0,2}')));
    }

    match /decisions/{key} {
      allow read, delete: if isAdmin();
      // Still admin-only; the tag check is not a gate but a typo guard. A tag
      // outside the vocabulary would publish an idTags entry no extension has
      // ever heard of, and blockTags matches by inclusion -- so a misspelt
      // verdict silently stops being blocked by anyone rather than failing
      // loudly here.
      //
      // 'public' is the transparency site's opt-in: approving a target blocks
      // it, publishing names it on a page the owner runs, and the schema keeps
      // those two verdicts apart on purpose. Only its TYPE is checked here --
      // who may set it was never in question, it is an admin-only document.
      allow create, update: if isAdmin()
          && optTag(request.resource.data, 'tag')
          && optBool(request.resource.data, 'public');
    }

    // The claim itself. `create` is the only opening: it succeeds solely when
    // the document does not exist, so the second caller to try gets a failure
    // rather than a takeover, and the list they would have to overwrite is
    // admin-only. A claimer may name only themselves -- one uid, their own --
    // so this cannot be used to install somebody else.
    match /admin/allowlist {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uids', 'claimedAt', 'claimedBy'])
        && request.resource.data.uids is list
        && request.resource.data.uids.size() == 1
        && request.resource.data.uids[0] == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /admin/{doc} {
      allow read, write: if isAdmin();
    }
  }
}
