{
  "manifest_version": 3,
  "name": "3Que Blocker",
  "version": "1.0.0",
  "description": "Fetches a profile-ID blocklist from your server and suppresses (and optionally platform-blocks) those profiles on Facebook and Threads.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.threads.net/*",
    "https://*.threads.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.threads.net/*",
        "https://*.threads.com/*"
      ],
      "js": [
        "src/main/inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.threads.net/*",
        "https://*.threads.com/*"
      ],
      "js": [
        "src/common/protocol.js",
        "src/content/bridge.js",
        "src/content/identity.js",
        "src/content/dom-blocker.js",
        "src/content/report-ui.js",
        "src/content/main.js"
      ],
      "css": [
        "src/content/blocker.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "3Que Blocker"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
