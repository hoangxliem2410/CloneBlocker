{
  "name": "cloneblocker",
  "version": "1.0.0",
  "description": "Chrome MV3 extension: fetch a profile-ID blocklist from your server and apply it on Facebook and Threads.",
  "private": true,
  "scripts": {
    "test": "node tools/check.js && node tools/queue-test.js && node tools/firebase-test.js && node tools/e2e-test.js",
    "test:headful": "node tools/e2e-test.js --headful",
    "icons": "node tools/make-icons.js",
    "check": "node tools/check.js",
    "test:queue": "node tools/queue-test.js",
    "test:browser": "node tools/e2e-test.js",
    "test:static": "node tools/check.js",
    "test:firebase": "node tools/firebase-test.js",
    "fb": "node tools/fb.js",
    "emulators": "node tools/fb.js emulators:start --project demo-clone",
    "deploy": "node tools/fb.js deploy --only firestore,hosting",
    "store-assets": "node tools/make-store-assets.js"
  },
  "engines": {
    "node": ">=20"
  }
}
